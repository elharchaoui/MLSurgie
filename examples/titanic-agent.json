{
  "goal": {
    "description": "Construct a small neural network predicting passenger survival from the supplied pre-outcome attributes. Write all weights directly. Investigate development errors and revise weights without fitting or gradient methods.",
    "target": "survived",
    "positive_label": "1",
    "primary_metric": "log_loss",
    "threshold": 0.5
  },
  "features": [
    {
      "name": "pclass",
      "kind": "categorical",
      "description": "Passenger ticket class"
    },
    {
      "name": "sex",
      "kind": "categorical",
      "description": "Recorded passenger sex"
    },
    {
      "name": "age",
      "kind": "numeric",
      "description": "Age in years; may be missing"
    },
    {
      "name": "sibsp",
      "kind": "numeric",
      "description": "Siblings/spouses aboard"
    },
    {
      "name": "parch",
      "kind": "numeric",
      "description": "Parents/children aboard"
    },
    {
      "name": "fare",
      "kind": "numeric",
      "description": "Ticket fare"
    },
    {
      "name": "embarked",
      "kind": "categorical",
      "description": "Embarkation port"
    }
  ],
  "budget": {
    "iterations": 8,
    "max_parameters": 65536,
    "max_width": 256,
    "max_hidden_layers": 8,
    "max_seconds": 3600,
    "max_editor_tokens": 200000,
    "max_output_tokens": 16384
  },
  "seed": 42
}
