{
  "name": "diabetes",
  "dataset": "../data/diabetes.csv",
  "notes": "Efron et al. diabetes progression (scikit-learn bundled copy, unscaled). Regression.",
  "goal": {
    "task": "regression",
    "description": "Predict a quantitative measure of diabetes disease progression one year after baseline.",
    "target": "progression",
    "primary_metric": "rmse"
  },
  "features": [
    {
      "name": "age",
      "kind": "numeric",
      "description": "Age in years"
    },
    {
      "name": "sex",
      "kind": "categorical",
      "description": "Sex, coded 1 or 2"
    },
    {
      "name": "bmi",
      "kind": "numeric",
      "description": "Body mass index"
    },
    {
      "name": "bp",
      "kind": "numeric",
      "description": "Average blood pressure"
    },
    {
      "name": "s1",
      "kind": "numeric",
      "description": "Total serum cholesterol"
    },
    {
      "name": "s2",
      "kind": "numeric",
      "description": "Low-density lipoproteins"
    },
    {
      "name": "s3",
      "kind": "numeric",
      "description": "High-density lipoproteins"
    },
    {
      "name": "s4",
      "kind": "numeric",
      "description": "Total cholesterol / HDL"
    },
    {
      "name": "s5",
      "kind": "numeric",
      "description": "Log of serum triglycerides"
    },
    {
      "name": "s6",
      "kind": "numeric",
      "description": "Blood sugar level"
    }
  ],
  "budget": {
    "iterations": 8,
    "max_parameters": 65536,
    "max_width": 256,
    "max_hidden_layers": 4,
    "max_output_tokens": 16384
  }
}
