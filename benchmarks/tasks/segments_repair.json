{
  "name": "segments_repair",
  "dataset": "../data/segments.csv",
  "notes": "Repair task: a deployed 4-segment nearest-centroid model with two planted faults is the starting best. Diagnose and patch.",
  "goal": {
    "task": "clustering",
    "description": "A deployed customer-segmentation network (4 segments) has degraded after a faulty manual edit. Diagnose and repair it.",
    "n_clusters": 4,
    "reference_column": "segment",
    "primary_metric": "silhouette"
  },
  "features": [
    {
      "name": "annual_spend",
      "kind": "numeric",
      "description": "Annual spend in USD"
    },
    {
      "name": "visits_per_month",
      "kind": "numeric",
      "description": "Store or site visits per month"
    },
    {
      "name": "avg_basket",
      "kind": "numeric",
      "description": "Average basket value in USD"
    },
    {
      "name": "days_since_last_visit",
      "kind": "numeric",
      "description": "Recency in days"
    },
    {
      "name": "online_share",
      "kind": "numeric",
      "description": "Share of purchases made online, 0-1"
    },
    {
      "name": "age",
      "kind": "numeric",
      "description": "Customer age in years"
    }
  ],
  "budget": {
    "iterations": 8,
    "max_parameters": 65536,
    "max_width": 256,
    "max_hidden_layers": 4,
    "max_output_tokens": 16384
  },
  "initial_program": "segments_repair.program.json",
  "initial_preprocessing": "segments_repair.preprocessing.json"
}
